# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App secrets
ENCRYPTION_SECRET=change-me-to-a-random-32-plus-character-string
FRONTEND_URL=https://your-deployment.vercel.app

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails auto-promoted to super_admin on first signup
SUPER_ADMIN_EMAILS=sbhuvan847@gmail.com,sbhuvan832@gmail.com

# Comma-separated allowed CORS origins. Leave blank to default to
# FRONTEND_URL + localhost:5173 (Vite dev server).
CORS_ORIGINS=

# Training round cap per request (serverless time-limit safety valve)
MAX_TRAINING_ROUNDS=30

# Local dev server port for the Express API (npm run dev:api)
PORT=8000

# Google Gemini API Key for AI Agent
VITE_GEMINI_API_KEY=your-gemini-api-key
